{
  "entities": {
    "Setting": {
      "title": "Setting",
      "description": "Global store settings including maintenance mode",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "adminEmails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "customerEmail": { "type": "string" },
        "total": { "type": "number" },
        "items": { "type": "array" }
      }
    },
    "ArchiveItem": {
      "title": "ArchiveItem",
      "description": "Archived deleted items retained for 45 days",
      "type": "object",
      "properties": {
        "originalId": { "type": "string" },
        "table": { "type": "string" },
        "itemType": { "type": "string" },
        "name": { "type": "string" },
        "deletedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      }
    },
    "SessionLog": {
      "title": "SessionLog",
      "description": "User and admin login, duration, location, IP and device tracking records",
      "type": "object",
      "properties": {
        "userType": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "ip": { "type": "string" },
        "location": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "deviceModel": { "type": "string" },
        "deviceType": { "type": "string" },
        "os": { "type": "string" },
        "browser": { "type": "string" },
        "loginAt": { "type": "string" },
        "logoutAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/system/{settingId}": {
      "schema": "Setting",
      "description": "Global settings for the store"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/archive/{archiveId}": {
      "schema": "ArchiveItem",
      "description": "Archived deleted items with 45-day retention"
    },
    "/sessions/{sessionId}": {
      "schema": "SessionLog",
      "description": "User and admin activity, duration, location and device logs"
    }
  }
}
